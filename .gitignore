node_modules/
# `npm install` is run with an in-tree cache during development because the
# default one is not always writable; the cache is build output, not source.
.npm-cache/
*.log
.DS_Store
# Scratch verification scripts and probes are written next to the plugin during
# development; only the shipped plugin belongs in the repository.
verify-*.mjs
probe-*.mjs
diagnose-*.mjs
reproduce-*.mjs
*.tgz
# Local agent metadata: project memory and pre-merge backup patches. It records
# absolute paths on the development machine and the working notes behind each
# change, none of which belongs in a published repository.
.workbuddy-ai/
